# Copy to .env, keep private, and launch with:
# node --env-file=.env src/server.mjs
# The existing launchers inherit environment variables; they do not load .env automatically.

# All monitoring/open tracking is opt-in.
FC_MONITOR_ENABLED=1
FC_IMAP_HOST=mail.privateemail.com
FC_IMAP_USER=outreach@yourdomain.com
FC_IMAP_PASSWORD=your_mailbox_or_app_password
FC_IMAP_INBOX_FOLDER=INBOX
FC_IMAP_SENT_FOLDER=

# Blank discovers the folder carrying the IMAP \\Sent special-use flag.
FC_IMAP_SENT_FOLDER=
# Optional multiple sender mailboxes. Use passwordEnv/accessTokenEnv references, never inline secrets.
FC_IMAP_MAILBOXES='[]'
# Example (instead of FC_IMAP_USER):
# FC_IMAP_MAILBOXES='[{"id":"dispatch","user":"sender@example.com","host":"mail.privateemail.com","passwordEnv":"DISPATCH_IMAP_PASSWORD","sentFolder":"Sent"}]'
# DISPATCH_IMAP_PASSWORD=replace-with-mailbox-or-application-password

FC_OPEN_TRACKING_ENABLED=0
# Set only after authorizing this telemetry and addressing applicable disclosure/consent requirements.
FC_OPEN_TRACKING_CONSENT=0
FC_TRACKING_PUBLIC_URL=https://www.fclogistics.us/t/1
FC_PIXEL_HOST=127.0.0.1
FC_PIXEL_PORT=4319

# Firebase 24/7 Open Tracking Sync (No ngrok needed; receives opens while PC is off)
# Give each PC a different ID (1, 2, 3, 4). Settings can override this value.
# The /t/PC part of FC_TRACKING_PUBLIC_URL must match that PC's cloud route.
FC_TRACKING_PC_ID=1
# Database URL used by the cloud endpoint (shown in Settings):
# FC_FIREBASE_DATABASE_URL=https://ea-fclogistics-default-rtdb.asia-southeast1.firebasedatabase.app
# FC_FIREBASE_DISABLE=1  # Disables sync; Settings shows a warning.
# Option 1: Path to downloaded Firebase service account JSON key file:
# FC_FIREBASE_CREDENTIALS_PATH=./data/firebase-service-account.json
# Option 2: Full service account JSON or base64 encoded string:
# FC_FIREBASE_SERVICE_ACCOUNT_KEY=""
# Option 3: Individual credentials:
# FC_FIREBASE_PROJECT_ID=""
# FC_FIREBASE_CLIENT_EMAIL=""
# FC_FIREBASE_PRIVATE_KEY=""

# Dedicated mailboxes you control. [] means seed testing cannot send any messages.
FC_SEEDS='[]'
# Manual example (no inbox access credentials needed):
# FC_SEEDS='[{"id":"gmail-test","email":"bukhtyar.haider1@gmail.com","provider":"gmail"}]'
# Automated OAuth example (use actual folder paths; IMAP must be enabled/authorized):
# FC_SEEDS='[{"id":"gmail-test","email":"bukhtyar.haider1@gmail.com","provider":"gmail","host":"imap.gmail.com","accessTokenEnv":"GMAIL_SEED_ACCESS_TOKEN","folders":{"inbox":"INBOX","spam":"[Gmail]/Spam","other":[]}}]'
# GMAIL_SEED_ACCESS_TOKEN=replace-with-current-authorized-oauth-access-token
# Outlook requires OAuth, not a mailbox password:
# OUTLOOK_SEED_ACCESS_TOKEN=replace-with-current-authorized-oauth-access-token
# Yahoo/Gmail app passwords can be used only where the account supports them:
# use authMode:"app_password" and passwordEnv:"YAHOO_SEED_APP_PASSWORD" in FC_SEEDS.

# Existing options (optional):
# FC_DATA_DIR=/absolute/path/to/private-data
# PORT=4317
# FC_PYTHON=python3
# TEAM_TOKEN=replace-with-existing-team-token

# Carrier conversations (2.2): independent of delivery/bounce monitoring.
# Defaults apply until saved through Conversations > Read-only mailbox capture settings.
# Never place secrets in mailbox JSON; refer to credential variables instead.
FC_REPLY_CAPTURE_ENABLED=0
FC_REPLY_AUTO=0
FC_REPLY_MAILBOXES=[]
# FC_REPLY_MAILBOXES=[{"id":"rep1","email":"rep1@yourdomain.com","host":"mail.privateemail.com","passwordEnv":"REP1_IMAP_PASSWORD"}]
# REP1_IMAP_PASSWORD=your-authorized-provider-password-or-app-password
# For OAuth, use accessTokenEnv instead of passwordEnv. Tokens are not enrolled/refreshed by the app.
# FC_REPLY_SINCE=2026-10-01
FC_REPLY_BATCH=50
# New native defaults: all available history, all selectable folders except Drafts, 5 pages per folder.
# Existing saved UI configuration keeps its prior scope until explicitly changed.
FC_REPLY_ALL_HISTORY=1
FC_REPLY_ALL_FOLDERS=1
FC_REPLY_PAGES=5
# FC_EXPERIMENT_REPLY_* flags do not enable capture in the normal app.
