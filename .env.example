# Copy to .env, keep private, and launch with:
# node --env-file=.env src/server.mjs
# The existing launchers inherit environment variables; they do not load .env automatically.

# All monitoring/open tracking is opt-in.
FC_MONITOR_ENABLED=1
FC_IMAP_HOST=mail.privateemail.com
FC_IMAP_USER=outreach@yourdomain.com
FC_IMAP_PASSWORD=your_mailbox_or_app_password
FC_IMAP_INBOX_FOLDER=INBOX
FC_IMAP_SENT_FOLDER=

# Blank discovers the folder carrying the IMAP \\Sent special-use flag.
FC_IMAP_SENT_FOLDER=
# Optional multiple sender mailboxes. Use passwordEnv/accessTokenEnv references, never inline secrets.
FC_IMAP_MAILBOXES='[]'
# Example (instead of FC_IMAP_USER):
# FC_IMAP_MAILBOXES='[{"id":"dispatch","user":"sender@example.com","host":"mail.privateemail.com","passwordEnv":"DISPATCH_IMAP_PASSWORD","sentFolder":"Sent"}]'
# DISPATCH_IMAP_PASSWORD=replace-with-mailbox-or-application-password

FC_OPEN_TRACKING_ENABLED=0
# Set only after authorizing this telemetry and addressing applicable disclosure/consent requirements.
FC_OPEN_TRACKING_CONSENT=0
FC_TRACKING_PUBLIC_URL=https://www.fclogistics.us/t/1
FC_PIXEL_HOST=127.0.0.1
FC_PIXEL_PORT=4319

# Dedicated mailboxes you control. [] means seed testing cannot send any messages.
FC_SEEDS='[]'
# Manual example (no inbox access credentials needed):
# FC_SEEDS='[{"id":"gmail-test","email":"your-dedicated-test@gmail.com","provider":"gmail"}]'
# Automated OAuth example (use actual folder paths; IMAP must be enabled/authorized):
# FC_SEEDS='[{"id":"gmail-test","email":"your-dedicated-test@gmail.com","provider":"gmail","host":"imap.gmail.com","accessTokenEnv":"GMAIL_SEED_ACCESS_TOKEN","folders":{"inbox":"INBOX","spam":"[Gmail]/Spam","other":[]}}]'
# GMAIL_SEED_ACCESS_TOKEN=replace-with-current-authorized-oauth-access-token
# Outlook requires OAuth, not a mailbox password:
# OUTLOOK_SEED_ACCESS_TOKEN=replace-with-current-authorized-oauth-access-token
# Yahoo/Gmail app passwords can be used only where the account supports them:
# use authMode:"app_password" and passwordEnv:"YAHOO_SEED_APP_PASSWORD" in FC_SEEDS.

# Existing options (optional):
# FC_DATA_DIR=/absolute/path/to/private-data
# PORT=4317
# FC_PYTHON=python3
# TEAM_TOKEN=replace-with-existing-team-token
