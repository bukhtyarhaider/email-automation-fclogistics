# Copy this file to .env.experiment, fill in only authorized mailbox credentials,
# then launch: node --env-file=.env.experiment scripts/experiment.mjs
# .env.experiment is private/ignored. Do not copy production browser sessions/keys.
FC_EXPERIMENT_REPLY_CAPTURE_ENABLED=0
FC_EXPERIMENT_REPLY_AUTO=0
FC_EXPERIMENT_REPLY_MAILBOXES='[]'
# Example (up to 20 mailboxes; five salespeople can use this consolidated inbox):
# FC_EXPERIMENT_REPLY_MAILBOXES='[{"id":"rep1","email":"rep1@yourdomain.com","user":"rep1@yourdomain.com","host":"mail.privateemail.com","passwordEnv":"REP1_IMAP_PASSWORD","inboxFolder":"INBOX","sentFolder":"Sent"}]'
# REP1_IMAP_PASSWORD=replace-with-authorized-mailbox-or-app-password
# Or use accessTokenEnv with a provider-approved OAuth token. Outlook requires OAuth.
# Gmail/Yahoo app passwords need authMode:"app_password" and provider:"gmail"/"yahoo".
# Tokens are not enrolled/refreshed by this experiment; rotate through the provider's approved flow.
# The email must match confirmed send history loaded from FC_EXPERIMENT_SOURCE.
# Never put password, pass, accessToken or token values directly into mailbox JSON.

# Initial scan defaults to the last 30 days; explicitly set an earlier date if needed:
# FC_EXPERIMENT_REPLY_SINCE=2026-10-01
FC_EXPERIMENT_REPLY_BATCH=50
# Each folder processes at most 50 messages/check, in UID order; maximum 100.
# Automatic mode wakes every 15 seconds but each account waits at least 60 seconds
# between successful checks. Failures back off up to an hour. Read-only IMAP only.
# FC_EXPERIMENT_SOURCE=/absolute/path/to/data
# FC_EXPERIMENT_DATA_DIR=/absolute/path/to/experiment-data
# FC_EXPERIMENT_PORT=4327
